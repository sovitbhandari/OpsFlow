{
  "ConnectionStrings": {
    "OpsFlow": ""
  },
  "DataProtection": {
    "KeysPath": "data/keys",
    "BlobUri": "",
    "ApplicationName": "OpsFlow"
  },
  "Attachments": {
    "Provider": "Local",
    "LocalPath": "data/attachments",
    "BlobContainerUri": "",
    "MaxBytes": 10485760,
    "MaxPerWorkOrder": 5
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "opsflow@localhost",
    "FromName": "OpsFlow",
    "EnableSsl": false
  },
  "Idempotency": {
    "CompletedRetentionHours": 24,
    "InProgressLeaseSeconds": 120
  },
  "Worker": {
    "PollIntervalSeconds": 5,
    "OutboxBatchSize": 20,
    "LeaseSeconds": 60,
    "MaxAttempts": 5,
    "SlaScanBatchSize": 50
  },
  "Seed": {
    "DemoPassword": ""
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "WritePermitLimit": 120
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
