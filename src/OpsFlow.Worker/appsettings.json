{
  "ConnectionStrings": {
    "OpsFlow": ""
  },
  "Attachments": {
    "Provider": "Local",
    "LocalPath": "data/attachments"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "opsflow@localhost",
    "FromName": "OpsFlow",
    "EnableSsl": false
  },
  "Idempotency": {
    "CompletedRetentionHours": 24,
    "InProgressLeaseSeconds": 120
  },
  "Worker": {
    "PollIntervalSeconds": 5,
    "OutboxBatchSize": 20,
    "LeaseSeconds": 60,
    "MaxAttempts": 5,
    "SlaScanBatchSize": 50
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
