# Copy to .env for Docker Compose. Do not commit real values.
# ASP.NET Core maps double underscores to nested configuration keys.

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__OpsFlow="Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=OpsFlow;Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Default;"
Seed__DemoPassword=REPLACE_ME
SQL_SA_PASSWORD=REPLACE_ME
Attachments__Provider=Local
Attachments__LocalPath=data/attachments
DataProtection__KeysPath=data/keys
DataProtection__BlobUri=
Smtp__Host=localhost
Smtp__Port=1025
Smtp__FromAddress=opsflow@localhost
Smtp__EnableSsl=false
OpenTelemetry__OtlpEndpoint=

# Integration tests. The database name must contain OpsFlowTests.
# OPSFLOW_USE_TESTCONTAINERS=true
# OPSFLOW_TEST_CONNECTION="Server=localhost,1433;Database=OpsFlowTests;User Id=sa;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=True"

# Benchmarks. The database name must contain OpsFlowBenchmark.
# OPSFLOW_BENCHMARK_CONNECTION="Server=localhost,1433;Database=OpsFlowBenchmark;User Id=sa;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=True"
